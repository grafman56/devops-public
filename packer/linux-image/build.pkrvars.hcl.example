# Copy to build.pkrvars.hcl and fill in. build.pkrvars.hcl is ignored.
# Secrets stay in environment variables: PROXMOX_TOKEN, BUILD_PASSWORD.

proxmox_url        = "https://pve.example.internal:8006/api2/json"
proxmox_username   = "packer@pve!packer"
proxmox_node       = "pve01"
vm_id              = 9001
vm_name            = "ubuntu-2604-template"
storage_pool       = "local-lvm"
bridge             = "vmbr0"
vlan_tag           = ""
iso_file           = "local:iso/ubuntu-26.04.1-live-server-amd64.iso"
build_username     = "packer"
