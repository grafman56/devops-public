---
# Secrets. Copy to secrets.yml, fill in, then encrypt:
#   ansible-vault encrypt inventories/windows/group_vars/secrets.yml
#
# secrets.yml is gitignored. The plaintext file must never be committed.

vault_local_admin_password: "REPLACE_WITH_THE_BUILD_PASSWORD"
vault_safe_mode_password: "REPLACE_WITH_A_DIFFERENT_STRONG_PASSWORD"
vault_domain_admin_user: "LAB\\Administrator"
vault_domain_admin_password: "REPLACE_WITH_THE_DOMAIN_ADMIN_PASSWORD"
