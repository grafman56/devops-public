# Managed by Ansible.
# Compose specification: https://compose-spec.io/
#
# Volume path note: from PostgreSQL 18 the image stores data in
# /var/lib/postgresql/<major>/docker, and the declared volume is
# /var/lib/postgresql. Mount the parent path for 18 and later.

services:
  web:
    image: "{{ docker_web_image }}"
    restart: unless-stopped
    ports:
      - "{{ docker_web_port }}:80"
    volumes:
      - ./html:/usr/share/nginx/html:ro
    depends_on:
      db:
        condition: service_healthy

  db:
    image: "{{ docker_db_image }}"
    restart: unless-stopped
    environment:
      POSTGRES_DB: "{{ docker_db_name }}"
      POSTGRES_USER: "{{ docker_db_user }}"
      POSTGRES_PASSWORD: "${POSTGRES_PASSWORD}"
    ports:
      - "127.0.0.1:{{ docker_db_port }}:5432"
    volumes:
      - db-data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 5

volumes:
  db-data:
