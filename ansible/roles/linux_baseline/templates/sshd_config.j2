# Managed by Ansible. Local changes are overwritten.
# Reference: man 5 sshd_config, https://manpages.debian.org/trixie/openssh-server/sshd_config.5.en.html

Port 22

# Host keys. Regenerate with ssh-keygen -A if a file is missing.
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key

PermitRootLogin {{ baseline_ssh_permit_root_login }}
PubkeyAuthentication yes
PasswordAuthentication {{ 'yes' if baseline_ssh_password_authentication | bool else 'no' }}
KbdInteractiveAuthentication no
UsePAM yes
{% if baseline_ssh_allowed_users | length > 0 %}
AllowUsers {{ baseline_ssh_allowed_users | join(' ') }}
{% endif %}

X11Forwarding no
PrintMotd no
ClientAliveInterval 300
ClientAliveCountMax 2
MaxAuthTries 4
LoginGraceTime 30

Subsystem sftp /usr/lib/openssh/sftp-server

# Include last. sshd uses the first value it reads for each keyword, so the
# explicit settings above win over drop-ins such as the cloud-init file.
Include /etc/ssh/sshd_config.d/*.conf
